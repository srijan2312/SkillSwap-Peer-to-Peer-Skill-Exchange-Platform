# SkillSwap client configuration
#
# Copy this file to `.env` and adjust the value for your setup:
#   cp .env.example .env
#
# Base URL of the SkillSwap backend API (no trailing slash).
# Read at build time via `import.meta.env.VITE_API_URL`.
# Falls back to http://localhost:5000/api when not set.
VITE_API_URL=http://localhost:5000/api
